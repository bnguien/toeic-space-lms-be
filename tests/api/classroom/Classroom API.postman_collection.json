      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"classId\": \"{{classId}}\",\n  \"teacherId\": \"{{teacherId}}\",\n  \"title\": \"Newman conflict check\",\n  \"description\": \"Expected conflict against seeded session\",\n  \"sessionType\": \"Regular\",\n  \"startAt\": \"{{sessionStartAt}}\",\n  \"endAt\": \"{{sessionEndAt}}\",\n  \"mode\": \"{{sessionMode}}\",\n  \"roomId\": {{sessionRoomJson}},\n  \"notes\": null\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{classroomBaseUrl}}/api/v1/class-sessions",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }
      },
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
          "const room = pm.environment.get('sessionRoomId');",
          "pm.environment.set('sessionRoomJson', room ? JSON.stringify(room) : 'null');"
        ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('TC-18: Reject Overlapping Session', function () {",
          "  pm.response.to.have.status(409);",
          "  pm.expect(pm.response.json().code).to.eql('schedule_conflict');",
