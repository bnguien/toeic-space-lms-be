    {
      "name": "TC-22: Reject Stale Schedule Version",
      "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{{scheduleUpdateBody}}", "options": { "raw": { "language": "json" } } }, "url": "{{classroomBaseUrl}}/api/v1/classes/{{classId}}/schedules/{{scheduleId}}", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] } },
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
          "const schedule = JSON.parse(pm.environment.get('scheduleData'));",
          "const input = { classId: schedule.classId, daysOfWeek: schedule.daysOfWeek, startTime: schedule.startTime, endTime: schedule.endTime, teacherId: schedule.teacherId, mode: schedule.mode, timeZoneId: schedule.timeZoneId, effectiveFrom: schedule.effectiveFrom, effectiveTo: schedule.effectiveTo, excludeDates: schedule.excludeDates };",
          "pm.environment.set('scheduleUpdateBody', JSON.stringify({ input, expectedVersion: schedule.version - 1 }));"
        ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('TC-22: Reject Stale Schedule Version', function () {",
          "  pm.response.to.have.status(409);",
          "  pm.expect(pm.response.json().code).to.eql('concurrency_conflict');",
          "});"
        ] } }
      ]
    },
    {
      "name": "TC-23: Reject Parallel Stale Schedule Updates",
      "request": { "method": "GET", "header": [], "url": "{{classroomBaseUrl}}/api/v1/classes/{{classId}}/schedules/{{scheduleId}}", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('TC-23: Load Schedule Before Parallel Stale Updates', function () { pm.response.to.have.status(200); });",
        "const schedule = pm.response.json();",
        "const input = { classId: schedule.classId, daysOfWeek: schedule.daysOfWeek, startTime: schedule.startTime, endTime: schedule.endTime, teacherId: schedule.teacherId, mode: schedule.mode, timeZoneId: schedule.timeZoneId, effectiveFrom: schedule.effectiveFrom, effectiveTo: schedule.effectiveTo, excludeDates: schedule.excludeDates };",
        "const updateRequest = { url: `${pm.environment.get('classroomBaseUrl')}/api/v1/classes/${pm.environment.get('classId')}/schedules/${pm.environment.get('scheduleId')}`, method: 'PUT', header: { 'Content-Type': 'application/json', Authorization: `Bearer ${pm.environment.get('accessToken')}` }, body: { mode: 'raw', raw: JSON.stringify({ input, expectedVersion: schedule.version - 1 }) } };",
        "const results = [];",
        "const collect = (error, response) => { results.push({ error, response }); if (results.length === 2) pm.test('TC-23: Both Parallel Stale Updates Return 409 concurrency_conflict', function () { results.forEach(result => { pm.expect(result.error).to.equal(null); pm.expect(result.response.code).to.equal(409); pm.expect(result.response.json().code).to.eql('concurrency_conflict'); }); }); };",
        "pm.sendRequest(updateRequest, collect);",
        "pm.sendRequest(updateRequest, collect);"
      ] } }]
    },
    {
      "name": "TC-24: Repeated Recurring Generation Is Idempotent",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"from\": \"{{sessionOriginalLocalDate}}\",\n  \"to\": \"{{sessionOriginalLocalDate}}\",\n  \"excludeDates\": []\n}", "options": { "raw": { "language": "json" } } }, "url": "{{classroomBaseUrl}}/api/v1/classes/{{classId}}/schedules/generate", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('TC-24: Repeated Recurring Generation Is Idempotent', function () {",
        "  pm.response.to.have.status(200);",
        "  const result = pm.response.json();",
        "  pm.expect(result.affected).to.be.an('array').that.is.empty;",
        "  pm.expect(result.skipped).to.be.an('array').with.lengthOf.at.least(1);",
        "});"
      ] } }]
    },
    {
