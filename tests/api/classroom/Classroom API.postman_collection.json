    {
      "name": "TC-11: Reject Unknown Default Room",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
        "const unknownId = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, character => {",
        "  const random = Math.floor(Math.random() * 16);",
        "  return (character === 'x' ? random : (random & 0x3) | 0x8).toString(16);",
        "});",
        "pm.environment.set('unknownId', unknownId);"
      ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('TC-11: Reject Unknown Default Room', function () {",
        "  pm.response.to.have.status(404);",
        "  pm.expect(pm.response.json().code).to.eql('room_not_found');",
        "});"
      ] } }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"roomId\": \"{{unknownId}}\",\n  \"reason\": \"Negative API test\",\n  \"applyToFutureSessions\": false\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{classroomBaseUrl}}/api/v1/classes/{{classId}}/default-room",
