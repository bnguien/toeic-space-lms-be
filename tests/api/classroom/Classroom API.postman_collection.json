    {
      "name": "TC-15: Get Class Sessions",
      "request": { "method": "GET", "header": [], "url": "{{classroomBaseUrl}}/api/v1/class-sessions?from={{sessionFrom}}&to={{sessionTo}}&classId={{classId}}&status=Scheduled&page=1&pageSize=100", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] } },
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
          "const start = new Date(`${pm.environment.get('classStartDate')}T00:00:00.000Z`);",
          "const end = new Date(`${pm.environment.get('classEndDate')}T00:00:00.000Z`);",
          "start.setUTCDate(start.getUTCDate() - 1);",
          "end.setUTCDate(end.getUTCDate() + 2);",
          "pm.environment.set('sessionFrom', start.toISOString());",
          "pm.environment.set('sessionTo', end.toISOString());"
        ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('TC-15: Get Class Sessions', function () {",
          "  pm.response.to.have.status(200);",
          "  const body = pm.response.json();",
          "  pm.expect(body.items).to.be.an('array').with.lengthOf.at.least(1);",
          "  const session = body.items.find(item => item.status === 'Scheduled' && item.classScheduleId);",
          "  pm.expect(session).to.exist;",
          "  pm.environment.set('sessionId', session.id);",
          "  pm.environment.set('sessionStartAt', session.startAt);",
          "  pm.environment.set('sessionEndAt', session.endAt);",
          "  pm.environment.set('teacherId', session.teacherId);",
          "  pm.environment.set('sessionMode', session.mode);",
          "  pm.environment.set('sessionRoomId', session.roomId || '');",
          "  pm.environment.set('sessionScheduleId', session.classScheduleId);",
          "  pm.environment.set('sessionOriginalLocalDate', session.originalLocalDate);",
          "});"
        ] } }
      ]
    },
