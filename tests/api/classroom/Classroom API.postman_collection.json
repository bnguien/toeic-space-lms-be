    {
      "name": "TC-08: Get Demo Classes Successfully",
      "request": { "method": "GET", "header": [], "url": "{{classroomBaseUrl}}/api/v1/classes?search=DEMO-TOEIC&page=1&pageSize=20", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('TC-08: Get Demo Classes Successfully', function () {",
        "  pm.response.to.have.status(200);",
        "  const body = pm.response.json();",
        "  pm.expect(body.items).to.be.an('array').with.lengthOf.at.least(4);",
        "  const demo = body.items.find(item => item.code === 'DEMO-TOEIC-800-MW');",
        "  pm.expect(demo, 'seeded 800+ class').to.exist;",
        "  pm.expect(demo.startDate).to.be.a('string');",
        "  pm.expect(demo.endDate).to.be.a('string');",
        "  pm.environment.set('classId', demo.id);",
        "  pm.environment.set('classDefaultRoomId', demo.defaultRoomId);",
        "  pm.environment.set('classStartDate', demo.startDate);",
        "  pm.environment.set('classEndDate', demo.endDate);",
        "});"
      ] } }]
    },
