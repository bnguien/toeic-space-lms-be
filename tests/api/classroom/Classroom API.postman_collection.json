{
  "info": {
    "_postman_id": "51c3f40f-ec6f-405b-8edf-968ae9bd02d2",
    "name": "ToeicSpace Classroom API Tests",
    "description": "Sequential Newman API checks against the existing Classroom demo dataset. Read-only tests use seeded records; write requests are validation failures or a no-op same-room assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-01: Login as Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{identityBaseUrl}}/api/auth/login"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('TC-01: Login as Admin', function () {",
        "  pm.response.to.have.status(200);",
        "  const body = pm.response.json();",
        "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
        "  pm.expect(body.user.role).to.eql('Admin');",
        "  pm.environment.set('accessToken', body.accessToken);",
        "});"
      ] } }]
    },
    {
      "name": "TC-02: Get Centers Successfully",
      "request": { "method": "GET", "header": [], "url": "{{classroomBaseUrl}}/api/v1/centers?page=1&pageSize=20", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
