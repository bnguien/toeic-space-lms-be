COMPOSE_PROJECT_NAME=toeic-space-lms-be
# ASP.NET
ASPNETCORE_ENVIRONMENT=Development
# Exact trusted media source origin (scheme, host, port); configure this for the question bank.
# Retain R2 practice-retained/ objects without lifecycle expiration or source-file deletion.
PRACTICE_MEDIA_ALLOWED_ORIGIN=https://chill-zone.studychill.net

# API Gateway
API_GATEWAY_PORT=15050

# RabbitMQ
RABBITMQ_HOST=messagebroker
RABBITMQ_PORT=15672
RABBITMQ_MANAGEMENT_PORT=25672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=

#Redis
REDIS_PORT=16379

# Identity OTP HMAC key (at least 32 random characters)
IDENTITY_OTP_HMAC_SECRET=
IDENTITY_INACTIVE_ACCOUNT_RETENTION_DAYS=3

# Password recovery (independent from email verification)
PASSWORD_RESET_OTP_LIFETIME_MINUTES=5
PASSWORD_RESET_LIFETIME_MINUTES=5
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_FAILED_ATTEMPTS=5

# JWT (ES256). Generate the pair with: dotnet run scripts/GenerateJwtKeys.cs
# Only the Identity service receives the private key; other services get the public key.
JWT_ISSUER=toeicspace-lms-identity
JWT_AUDIENCE=toeicspace-lms-api
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Shared server-to-server credential. Configure the same value in Identity and Classroom.

# Networks whose X-Forwarded-For header is trusted (the gateway / reverse proxy)
TRUSTED_PROXY_NETWORK=172.16.0.0/12

# First administrator, created once at startup. Remove the password after the first run.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# R2: existing credentials are now also consumed by Assessment for retained practice media.
# Obtain credentials privately. Grant object read/write access to the configured bucket.
# Do not expire or delete the practice-retained/ prefix when source media is removed.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=toeic-space-media

# SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME=ToeicSpace
SMTP_SENDER_EMAIL=your-email@example.com
SMTP_PASSWORD=
SMTP_SUPPORT_EMAIL=support@toeicspace.com

# ==================================================
# IDENTITY DATABASE
# ==================================================

# Identity API
IDENTITY_API_PORT=16001

# Identity Database
IDENTITY_DB_ROOT_PASSWORD=

IDENTITY_DB_HOST=identity-db
IDENTITY_DB_PORT=13306
IDENTITY_DB_NAME=toeic_space_lms_identity
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=

# ==================================================
# ASSESSMENT DATABASE
# ==================================================

# Assessment API
ASSESSMENT_API_PORT=16004

# Assessment Database
ASSESSMENT_DB_ROOT_PASSWORD=

ASSESSMENT_DB_HOST=assessment-db
ASSESSMENT_DB_PORT=13307
ASSESSMENT_DB_NAME=toeic_space_lms_assessment
ASSESSMENT_DB_USER=assessment_user
ASSESSMENT_DB_PASSWORD=

# Classroom service/database
CLASSROOM_API_PORT=16003
CLASSROOM_DB_PORT=13308
CLASSROOM_DB_NAME=toeic_space_lms_classroom
CLASSROOM_DB_USER=classroom_user
CLASSROOM_DB_PASSWORD=
CLASSROOM_DB_ROOT_PASSWORD=

# Separate development OAuth client, LMS callback and token encryption key.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=
GOOGLE_MEET_ENCRYPTION_KEY=

# Content service/database
CONTENT_API_PORT=16005
CONTENT_DB_PORT=13309
CONTENT_DB_NAME=toeic_space_lms_content
CONTENT_DB_USER=content_user
CONTENT_DB_PASSWORD=
CONTENT_DB_ROOT_PASSWORD=

# Class tuition and SePay
PAYMENT_API_PORT=16006
PAYMENT_DB_PORT=13310
PAYMENT_DB_NAME=toeic_space_lms_payment
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=
PAYMENT_DB_ROOT_PASSWORD=
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_WEBHOOK_API_KEY=

# Pixabay videos API key for Vocabulary Reel backgrounds (free key: https://pixabay.com/api/docs/).
# Leave empty to disable the daily refresh.
PIXABAY_API_KEY=

# Vocabulary enrichment ("Thêm từ vựng"). All optional: without keys the AI tier and the paid Google Translate
# tier are skipped. GEMINI_API_KEYS is a comma/newline separated list rotated with cooldowns.
GEMINI_API_KEY=
GEMINI_API_KEYS=
DICT_AI_MODEL=
FLASHCARD_AI_MODEL=
GOOGLE_TRANSLATE_API_KEY=

